# Database
DATABASE_URL="postgresql://user:password@localhost:5432/incuto_join"

# Base domain for credit union subdomains
# Forms are served at [credit-union-slug].cuaccount.com/join/[form-slug]
BASE_DOMAIN="cuaccount.com"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Demo Mode (set to "true" to allow login without password verification)
DEMO_MODE="true"

# Incuto API
INCUTO_API_URL="https://api.incuto.com"
INCUTO_API_KEY="your-incuto-api-key"

# Anthropic AI
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Vouchsafe (ID verification fallback)
VOUCHSAFE_API_URL="https://api.vouchsafe.co.uk"
VOUCHSAFE_API_KEY="your-vouchsafe-api-key"
