generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// MULTI-TENANCY
// ─────────────────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Branding
  primaryColor    String  @default("#1E40AF")
  secondaryColor  String  @default("#DBEAFE")
  accentColor     String  @default("#3B82F6")
  logoUrl         String?
  faviconUrl      String?
  fontFamily      String  @default("Inter")
  borderRadius    String  @default("8")
  customCss       String?

  // Incuto API credentials
  incutoApiUrl    String?
  incutoApiKey    String?
  incutoTenantId  String?

  // Settings
  idCheckEnabled      Boolean @default(true)
  vouchsafeEnabled    Boolean @default(true)
  aiChatbotEnabled    Boolean @default(true)
  chatbotPersonality  String? // JSON config for chatbot

  users        User[]
  forms        Form[]
  commonBonds  CommonBond[]
  landingPages LandingPage[]
  applications Application[]

  @@map("tenants")
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String
  name      String
  password  String?
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

// ─────────────────────────────────────────────────────────────
// COMMON BOND
// ─────────────────────────────────────────────────────────────

model CommonBond {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  name        String
  type        CommonBondType
  description String?
  values      Json           // array of postcodes / regions / employers etc.
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("common_bonds")
}

enum CommonBondType {
  GEOGRAPHICAL
  POSTCODE
  EMPLOYMENT
  COMMUNITY
  ASSOCIATION
}

// ─────────────────────────────────────────────────────────────
// FORMS
// ─────────────────────────────────────────────────────────────

model Form {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  name        String
  slug        String
  description String?
  status      FormStatus @default(DRAFT)
  formType    FormType   @default(STANDARD)

  // What products this form handles
  includesSavings Boolean @default(true)
  includesLoan    Boolean @default(false)
  allowsCorporate Boolean @default(false)
  allowsChildren  Boolean @default(false)

  // Loan redirect config
  loanRedirectUrl  String?
  loanJourneyEmbed Boolean @default(false)

  // Branding overrides (inherits from tenant if null)
  brandingOverride Json?

  // AI chatbot config for this form
  chatbotEnabled    Boolean @default(false)
  chatbotConfig     Json?

  // Common bond enforcement
  requireCommonBond Boolean @default(true)

  // Form structure
  sections     FormSection[]
  landingPages LandingPageForm[]
  applications Application[]

  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([tenantId, slug])
  @@map("forms")
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormType {
  STANDARD      // General join form
  SAVINGS_ONLY  // Savings account only
  LOAN          // Loan application
  ISA           // ISA product
  CORPORATE     // Business member
  CHILDREN      // Junior member
  CAMPAIGN      // Landing page-specific form
}

model FormSection {
  id          String  @id @default(cuid())
  formId      String
  form        Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  title       String
  description String?
  helpText    String?
  infoButton  Json?   // { title, content, type: 'tooltip'|'modal' }
  order       Int

  // Show/hide logic for entire section
  conditions  Json? // array of FieldCondition

  fields FormField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("form_sections")
}

model FormField {
  id          String    @id @default(cuid())
  sectionId   String
  section     FormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  fieldKey    String    // unique key within form e.g. "first_name"
  fieldType   FieldType
  label       String
  placeholder String?
  helpText    String?
  infoButton  Json?     // { title, content }
  required    Boolean   @default(false)
  order       Int

  // Validation
  validation  Json?  // { min, max, pattern, message, minLength, maxLength }

  // Options (for select/radio/checkbox fields)
  options     Json?  // array of { label, value }

  // Incuto field mapping — maps this field's collected value to an Incuto API field
  // e.g. "firstName", "address.line1", "employment.status"
  // Fields without a mapping go to customFields in the Incuto payload
  incutoFieldKey  String?
  isSystemField   Boolean  @default(false)  // mandatory field, can't be removed
  systemFieldName String?  // e.g. 'first_name', 'last_name', 'dob'

  // Show/hide logic
  conditions  Json?  // array of { fieldKey, operator, value, logic }

  // Styling
  width       FieldWidth @default(FULL)
  cssClass    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("form_fields")
}

enum FieldType {
  TEXT
  EMAIL
  PHONE
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  RADIO
  CHECKBOX
  TEXTAREA
  FILE_UPLOAD
  HEADING
  PARAGRAPH
  DIVIDER
  COMMON_BOND_SELECTOR
  PRODUCT_SELECTOR      // savings/loan/both
  MEMBER_TYPE_SELECTOR  // individual/corporate/child
  SIGNATURE
  ADDRESS_LOOKUP
  SORT_CODE
  ACCOUNT_NUMBER
  NATIONAL_INSURANCE
  ID_UPLOAD
  CONSENT
  DECLARATION
  LOAN_AMOUNT
  LOAN_PURPOSE
  LOAN_TERM
}

enum FieldWidth {
  FULL
  HALF
  THIRD
  TWO_THIRDS
}

// ─────────────────────────────────────────────────────────────
// LANDING PAGES
// Previously known as Campaigns — renamed to avoid confusion with
// Incuto Hub marketing campaigns. Landing pages are used to track
// traffic from marketing channels and link forms to specific URLs.
// ─────────────────────────────────────────────────────────────

model LandingPage {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  trackingCode String        @unique
  isActive    Boolean        @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  forms        LandingPageForm[]
  applications Application[]

  @@map("campaigns")
}

model LandingPageForm {
  id            String      @id @default(cuid())
  landingPageId String      @map("campaignId")
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id])
  formId        String
  form          Form        @relation(fields: [formId], references: [id])

  @@unique([landingPageId, formId])
  @@map("campaign_forms")
}

// ─────────────────────────────────────────────────────────────
// APPLICATIONS
// ─────────────────────────────────────────────────────────────

model Application {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  formId       String
  form         Form              @relation(fields: [formId], references: [id])
  landingPageId String?          @map("campaignId")
  landingPage  LandingPage?      @relation(fields: [landingPageId], references: [id])

  sessionId   String            @unique
  status      ApplicationStatus @default(STARTED)
  memberType  MemberType        @default(INDIVIDUAL)
  products    Json              // { savings: bool, loan: bool, savingsType: string }

  // Submitted form data (full JSON blob, preserved for audit)
  formData    Json?

  // Searchable per-field values — populated at submission time
  fieldValues ApplicationFieldValue[]

  // ID verification
  idCheckStatus    IdCheckStatus?
  idCheckData      Json?
  idCheckAttempts  Int            @default(0)
  vouchsafeStatus  VouchsafeStatus?
  vouchsafeData    Json?

  // Incuto submission
  incutoMemberId    String?
  incutoSubmittedAt DateTime?
  incutoResponse    Json?

  // Loan application
  loanApplicationId   String?
  loanRedirectedAt    DateTime?

  // Journey tracking
  currentSectionIndex Int     @default(0)
  completedSections   Json    @default("[]")
  dropoutSection      String?
  dropoutAt           DateTime?

  // Source tracking
  ipAddress    String?
  userAgent    String?
  referrer     String?
  utmParams    Json?

  startedAt    DateTime   @default(now())
  submittedAt  DateTime?
  completedAt  DateTime?
  updatedAt    DateTime   @updatedAt

  events ApplicationEvent[]

  @@map("applications")
}

// Searchable per-field store. One row per submitted field value.
// Enables full-text search across all applicants without scanning the formData JSON blob.
model ApplicationFieldValue {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fieldKey      String   // e.g. "first_name" — matches FormField.fieldKey
  fieldLabel    String   // e.g. "First Name" — denormalised for display
  stringValue   String?  // normalised to string for search/filtering
  rawValue      Json?    // original value as submitted (may be object/array/bool)

  // Denormalised from FormField.incutoFieldKey — tells us which Incuto field this maps to.
  // NULL means it is a custom field with no standard Incuto mapping.
  incutoFieldKey String?

  @@index([applicationId])
  @@index([fieldKey])
  @@index([stringValue])
  @@map("application_field_values")
}

enum ApplicationStatus {
  STARTED
  IN_PROGRESS
  SUBMITTED
  ID_CHECK_PENDING
  ID_CHECK_FAILED
  VOUCHSAFE_PENDING
  COMPLETED
  REJECTED
  ABANDONED
}

enum MemberType {
  INDIVIDUAL
  CORPORATE
  CHILD
  JOINT
}

enum IdCheckStatus {
  PENDING
  PASSED
  FAILED
  REQUIRES_MORE_INFO
}

enum VouchsafeStatus {
  NOT_REQUIRED
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  eventType     String      // 'section_view', 'field_interaction', 'section_complete', 'submit', etc.
  eventData     Json?
  sectionIndex  Int?
  fieldKey      String?
  timestamp     DateTime    @default(now())

  @@map("application_events")
}

// ─────────────────────────────────────────────────────────────
// ANALYTICS SNAPSHOTS (pre-computed for performance)
// ─────────────────────────────────────────────────────────────

model FormAnalyticsSnapshot {
  id       String   @id @default(cuid())
  formId   String
  date     DateTime
  period   String   // 'day', 'week', 'month'

  totalStarts      Int @default(0)
  totalCompletions Int @default(0)
  totalDropouts    Int @default(0)
  totalSubmissions Int @default(0)

  // Dropout by section (JSON: { sectionIndex: count })
  dropoutBySectionData Json?

  // Completion time (seconds)
  avgCompletionTime Float?

  // By product
  savingsCount  Int @default(0)
  loanCount     Int @default(0)
  bothCount     Int @default(0)

  // By member type
  individualCount Int @default(0)
  corporateCount  Int @default(0)
  childCount      Int @default(0)

  // By landing page
  landingPageData Json? @map("campaignData")

  createdAt DateTime @default(now())

  @@unique([formId, date, period])
  @@map("form_analytics_snapshots")
}
